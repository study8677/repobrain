{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repobrain.dev/schemas/codegraph-comparison-manifest-v2.json",
  "title": "RepoBrain CodeGraph comparison manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "created_at", "tools", "artifacts", "question_files", "repositories"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 2},
    "benchmark_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date"},
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repobrain", "codegraph", "answer_model"],
      "properties": {
        "repobrain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision", "version", "refresh_mode"],
          "properties": {
            "repository": {"type": "string", "format": "uri"},
            "revision": {"$ref": "#/$defs/gitSha"},
            "version": {"type": "string", "minLength": 1},
            "refresh_mode": {"enum": ["public_full"]}
          }
        },
        "codegraph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "package", "release", "npm_git_head", "dist_integrity"],
          "properties": {
            "repository": {"type": "string", "format": "uri"},
            "package": {"type": "string", "minLength": 1},
            "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"},
            "npm_git_head": {"$ref": "#/$defs/gitSha"},
            "dist_integrity": {"type": "string", "pattern": "^sha512-"}
          }
        },
        "answer_model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runner", "requested_model", "repobrain_host_command", "timeout_seconds"],
          "properties": {
            "runner": {"const": "trae-cli"},
            "requested_model": {"type": "string", "minLength": 1},
            "repobrain_host_command": {"type": "string", "minLength": 1},
            "timeout_seconds": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_root", "run_root"],
      "properties": {
        "work_root": {"type": "string", "pattern": "^\\.work/"},
        "run_root": {"type": "string", "pattern": "^results/runs(?:/|$)"}
      }
    },
    "question_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^config/.*\\.json$"}
    },
    "repositories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/repository"}
    }
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "release", "primary_language", "enabled", "stress", "tracks", "corpus", "corpora"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "revision": {"$ref": "#/$defs/gitSha"},
        "release": {"type": "string", "minLength": 1},
        "primary_language": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "stress": {"type": "boolean"},
        "tracks": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {"enum": ["index", "fair_e2e", "incremental", "unrestricted_native"]}
        },
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "include_paths"],
          "properties": {
            "mode": {"enum": ["full", "focused"]},
            "include_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "allOf": [
            {
              "if": {"properties": {"mode": {"const": "full"}}},
              "then": {"properties": {"include_paths": {"maxItems": 0}}}
            },
            {
              "if": {"properties": {"mode": {"const": "focused"}}},
              "then": {"properties": {"include_paths": {"minItems": 1}}}
            }
          ]
        },
        "corpora": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repobrain_query", "codegraph_query"],
          "properties": {
            "repobrain_query": {"type": "string", "pattern": "^\\.work/v2/corpora/"},
            "codegraph_query": {"type": "string", "pattern": "^\\.work/v2/corpora/"}
          }
        }
      }
    }
  }
}
